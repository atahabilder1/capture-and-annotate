{
  "manifest_version": 3,
  "name": "Capture and Annotate – Screenshot to PDF & Image",
  "short_name": "CapAnnotate",
  "version": "0.2.0",
  "description": "Capture an area, the visible page, a full page or any window. Annotate with arrows, text, steps and blur, then save as PNG, JPG or PDF.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "clipboardWrite"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Capture and Annotate",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "capture-area": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Select an area to capture"
    },
    "capture-visible": {
      "description": "Capture the visible part of the page"
    },
    "capture-full": {
      "description": "Capture the full page"
    },
    "capture-screen": {
      "description": "Capture a screen or window"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
